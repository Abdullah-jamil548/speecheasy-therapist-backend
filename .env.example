# Copy to .env and fill in real values

APP_NAME=SpeakEasy for Therapists API
DEBUG=true
API_PREFIX=/api

# JWT — use a long random string in production
JWT_SECRET=change-me-to-a-long-random-secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# Supabase — Project Settings → API (service_role is server-only)
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Public URL of this API (used in email verification / reset links)
APP_PUBLIC_URL=http://localhost:8000
# Doctor web app URL (Open Doctor app buttons on verify/reset pages)
DOCTOR_APP_URL=http://localhost:5050
FRONTEND_DEEP_LINK=speakeasyDoctor://auth

GOOGLE_CLIENT_IDS=26703591720-pt9vo0tdkudsqfd3dteeqi1kf1l7dluv.apps.googleusercontent.com

# SMTP (Gmail: use App Password, not account password)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your@gmail.com
SMTP_PASSWORD=your-app-password
SMTP_FROM_EMAIL=your@gmail.com
SMTP_FROM_NAME=SpeakEasy for Therapists
SMTP_USE_TLS=true
